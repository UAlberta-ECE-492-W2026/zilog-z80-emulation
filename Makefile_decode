.PHONY: clean waves run_sim

run_sim: .stamp.run_decode

.stamp.run_decode: obj_dir/Vdecode_tb out/sim
	./$<

obj_dir/Vdecode_tb: ./src/hdl/c_to_dp_intf.sv ./src/hdl/decode.sv ./src/sim/decode_tb.sv ./src/enum/reg_name.sv ./src/enum/mop.sv
	verilator --trace-vcd --binary -j 0 -Wall -cc $^ --top-module decode_tb --timing +incdir+./src/enum +incdir+./src/hdl

out/sim:
	mkdir -p ./out/sim

waves: .stamp.run_decode
	gtkwave out/sim/decode_tb.vcd

clean:
	rm -rf ./obj_dir/ ./out
