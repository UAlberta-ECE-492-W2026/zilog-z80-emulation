.PHONY: clean run_top

waveform.vcd: ./obj_dir/Vz80_top_for_testing
	@./obj_dir/Vz80_top_for_testing

./obj_dir/Vz80_top_for_testing: .stamp.verilate
	make -C obj_dir -f Vz80_top_for_testing.mk Vz80_top_for_testing

.stamp.verilate: ./src/hdl/z80_top_for_testing.sv ./src/sim/z80_top_tb_interactive.cpp ticks.txt
	verilator --trace-vcd --trace-structs --no-trace-top -Wall -cc z80_top_for_testing --exe ./src/sim/z80_top_tb_interactive.cpp +incdir+./src/enum +incdir+./src/hdl
	@touch .stamp.verilate

ticks.txt: 
	z88dk-ticks -x zilog-z80-emulation-software/internal_programs/prime_printer/prime_printer.map -end 47 -v -mz80 -d -trace -counter 100000 zilog-z80-emulation-software/internal_programs/prime_printer/prime_printer.out > ticks.txt

clean:
	rm -rf ./obj_dir/ ./out .stamp* ticks.txt
